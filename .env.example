# Every setting, with its default.
PORT=3000
# "development" shows error messages and restarts on code changes
ENV=development
# largest request body a bin will capture, in bytes
HOOKTRAP_MAX_BODY_BYTES=1048576
HOOKTRAP_MAX_BINS=200
# requests kept per bin; the oldest drop off
HOOKTRAP_MAX_REQUESTS=100
# a bin nobody has sent to or watched for this long is removed
HOOKTRAP_IDLE_HOURS=24
# hosts a captured request may be replayed to; * allows any host
HOOKTRAP_REPLAY_HOSTS=localhost,127.0.0.1,::1
HOOKTRAP_REPLAY_TIMEOUT_SECONDS=15
# shown as the capture URL when the app sits behind a tunnel (https://abc.ngrok.app)
HOOKTRAP_PUBLIC_URL=
